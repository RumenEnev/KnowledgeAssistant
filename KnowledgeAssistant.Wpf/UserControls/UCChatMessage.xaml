<UserControl
    x:Class="KnowledgeAssistant.Wpf.UserControls.UCChatMessage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mdxaml="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
    xmlns:system="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
    MinHeight="70"
    SizeChanged="UserControl_SizeChanged">

    <UserControl.Resources>
        <system:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid x:Name="MainGrid" Background="Wheat">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="30"
                Margin="2"
                Padding="5,0"
                Background="Wheat"
                BorderThickness="0"
                Click="ToggleSpeech_Click"
                ToolTip="Read aloud / Pause"
                Visibility="{Binding SpeechControlsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="14"
                    Text="{Binding SpeechIconGlyph}" />
            </Button>
            <Button
                Width="30"
                Margin="2"
                Padding="5,0"
                Background="Wheat"
                BorderThickness="0"
                Click="StopSpeech_Click"
                ToolTip="Stop reading">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding SpeechControlsVisible}" Value="True" />
                                    <Condition Binding="{Binding IsSpeaking}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="14"
                    Text="&#xE71A;" />
            </Button>
            <Button
                Width="30"
                Margin="2"
                Padding="5,0"
                Background="Wheat"
                BorderThickness="0"
                Click="Copy_Click"
                ToolTip="Copy">
                <TextBlock
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="14"
                    Text="&#xE8C8;" />
            </Button>
        </StackPanel>

        <mdxaml:MarkdownViewer
            x:Name="MarkdownContent"
            Grid.Row="1"
            Margin="5"
            VerticalAlignment="Top"
            Background="Wheat"
            FontSize="14"
            Markdown="{Binding Message}" />
    </Grid>
</UserControl>