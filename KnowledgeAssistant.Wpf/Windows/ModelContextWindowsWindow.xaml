<Window
    x:Class="KnowledgeAssistant.Wpf.Windows.ModelContextWindowsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Model Context Windows"
    Width="480"
    Height="480"
    Loaded="ModelContextWindowsWindow_Loaded"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,8"
            Text="Set the context window size (in tokens) for each installed model. Leave empty to use the model's default."
            TextWrapping="Wrap" />

        <ListView
            Grid.Row="1"
            Margin="0,0,0,8"
            ItemsSource="{Binding Models}">
            <ListView.View>
                <GridView>
                    <GridViewColumn
                        Width="180"
                        DisplayMemberBinding="{Binding Name}"
                        Header="Model" />
                    <GridViewColumn Width="120" Header="Context Window (tokens)">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox
                                    Width="110"
                                    Text="{Binding ContextWindowTokens, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="Leave empty to use the model's default." />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    Padding="8,2"
                                    Click="SaveModelContextWindow_Click"
                                    Content="{Binding SaveButtonText}"
                                    Tag="{Binding}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
