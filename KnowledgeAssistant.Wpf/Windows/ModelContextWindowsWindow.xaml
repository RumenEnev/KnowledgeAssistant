<Window
    x:Class="KnowledgeAssistant.Wpf.Windows.ModelContextWindowsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Model Context Windows"
    Width="820"
    Height="480"
    Loaded="ModelContextWindowsWindow_Loaded"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,8"
            Text="Installed models and their catalog information."
            TextWrapping="Wrap" />

        <ListView
            Grid.Row="1"
            Margin="0,0,0,8"
            ItemsSource="{Binding Models}">
            <ListView.View>
                <GridView>
                    <GridViewColumn
                        Width="200"
                        DisplayMemberBinding="{Binding Name}"
                        Header="Model" />
                    <GridViewColumn
                        Width="90"
                        DisplayMemberBinding="{Binding SizeDisplay}"
                        Header="Size" />
                    <GridViewColumn
                        Width="100"
                        DisplayMemberBinding="{Binding ParameterSize}"
                        Header="Parameters" />
                    <GridViewColumn
                        Width="110"
                        DisplayMemberBinding="{Binding ContextLength}"
                        Header="Context Length" />
                    <GridViewColumn
                        Width="100"
                        DisplayMemberBinding="{Binding Family}"
                        Header="Family" />
                    <GridViewColumn
                        Width="110"
                        DisplayMemberBinding="{Binding QuantizationLevel}"
                        Header="Quantization" />
                </GridView>
            </ListView.View>
        </ListView>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
