<Window
    x:Class="KnowledgeAssistant.Wpf.Windows.DocumentsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Manage Documents"
    Width="600"
    Height="760"
    Loaded="DocumentsWindow_Loaded"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView
            x:Name="documentsList"
            Grid.Row="0"
            Margin="0,0,0,8"
            ItemsSource="{Binding Documents}"
            SelectionChanged="DocumentsList_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn
                        Width="200"
                        DisplayMemberBinding="{Binding Title}"
                        Header="Title" />
                    <GridViewColumn
                        Width="200"
                        DisplayMemberBinding="{Binding TopicsDisplay}"
                        Header="Topics" />
                    <GridViewColumn Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    Padding="8,2"
                                    Click="DeleteDocument_Click"
                                    Content="Delete"
                                    Tag="{Binding}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <GroupBox
            Grid.Row="1"
            Margin="0,0,0,8"
            Header="{Binding FormHeader}">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="120" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,2,0,0"
                    FontWeight="Bold"
                    Text="Title (required)" />
                <TextBox
                    Grid.Row="1"
                    Margin="0,2,0,6"
                    Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="A short, descriptive name for the document." />

                <TextBlock
                    Grid.Row="2"
                    Margin="0,2,0,0"
                    FontWeight="Bold"
                    Text="Topics (select at least one, required)" />
                <Grid Grid.Row="3" Margin="0,2,0,6">
                    <ToggleButton
                        x:Name="topicsDropdownToggle"
                        Padding="8,5"
                        HorizontalContentAlignment="Left"
                        Content="{Binding SelectedTopicsSummary}"
                        ToolTip="Documents are grouped and searched by topic." />

                    <Popup
                        AllowsTransparency="True"
                        IsOpen="{Binding IsChecked, ElementName=topicsDropdownToggle}"
                        Placement="Bottom"
                        PlacementTarget="{Binding ElementName=topicsDropdownToggle}"
                        StaysOpen="False"
                        Width="{Binding ActualWidth, ElementName=topicsDropdownToggle}">
                        <Border
                            Background="White"
                            BorderBrush="Gray"
                            BorderThickness="1">
                            <TreeView
                                MaxHeight="220"
                                BorderThickness="0"
                                ItemsSource="{Binding TopicTree}">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="{x:Type TreeViewItem}">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <CheckBox
                                            Margin="2,3"
                                            Content="{Binding Name}"
                                            IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Border>
                    </Popup>
                </Grid>

                <TextBlock
                    Grid.Row="4"
                    Margin="0,2,0,0"
                    FontWeight="Bold"
                    Text="Text (required)" />
                <TextBox
                    Grid.Row="5"
                    Margin="0,2,0,0"
                    AcceptsReturn="True"
                    Text="{Binding NewText, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    ToolTip="The full document content to ingest and index."
                    VerticalScrollBarVisibility="Auto" />
                <StackPanel
                    Grid.Row="6"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Padding="8,4"
                        Click="LoadTextFromFile_Click"
                        Content="Load from file…"
                        ToolTip="Populate the text box with the contents of a .txt file." />
                    <Button
                        Margin="8,0,0,0"
                        Padding="10,4"
                        Click="CancelEdit_Click"
                        Content="Cancel"
                        Visibility="{Binding CancelButtonVisibility}" />
                    <Button
                        Margin="8,0,0,0"
                        Padding="10,4"
                        Click="AddDocument_Click"
                        Content="{Binding SubmitButtonText}"
                        IsEnabled="{Binding CanSubmit}" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox
            Grid.Row="2"
            Margin="0,0,0,8"
            Header="Chunking Settings">
            <StackPanel Margin="4">
                <TextBlock
                    Margin="0,0,0,6"
                    Text="Controls how document text is split before embedding. Chunk overlap must be smaller than chunk size. Changes apply the next time a document is added or updated."
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock FontWeight="Bold" Text="Chunk size (characters)" />
                        <TextBox
                            Width="140"
                            Text="{Binding ChunkTargetSizeChars, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Target size, in characters, for each chunk before embedding." />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock FontWeight="Bold" Text="Chunk overlap (characters)" />
                        <TextBox
                            Width="140"
                            Text="{Binding ChunkOverlapChars, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Number of trailing characters carried over into the next chunk for context continuity." />
                    </StackPanel>
                    <Button
                        Padding="10,4"
                        VerticalAlignment="Bottom"
                        Click="SaveChunkingSettings_Click"
                        Content="{Binding SaveChunkingSettingsButtonText}"
                        IsEnabled="{Binding CanSaveChunkingSettings}" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>