<Window
    x:Class="KnowledgeAssistant.Wpf.Windows.DocumentsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Manage Documents"
    Width="600"
    Height="680"
    Loaded="DocumentsWindow_Loaded"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView
            Grid.Row="0"
            Margin="0,0,0,8"
            ItemsSource="{Binding Documents}">
            <ListView.View>
                <GridView>
                    <GridViewColumn
                        Width="200"
                        DisplayMemberBinding="{Binding Title}"
                        Header="Title" />
                    <GridViewColumn
                        Width="200"
                        DisplayMemberBinding="{Binding TopicsDisplay}"
                        Header="Topics" />
                    <GridViewColumn Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    Padding="8,2"
                                    Click="DeleteDocument_Click"
                                    Content="Delete"
                                    Tag="{Binding}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <GroupBox
            Grid.Row="1"
            Margin="0,0,0,8"
            Header="Add Document">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="120" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,2,0,0"
                    FontWeight="Bold"
                    Text="Title (required)" />
                <TextBox
                    Grid.Row="1"
                    Margin="0,2,0,6"
                    Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="A short, descriptive name for the document." />

                <TextBlock
                    Grid.Row="2"
                    Margin="0,2,0,0"
                    FontWeight="Bold"
                    Text="Topics (select at least one, required)" />
                <Border
                    Grid.Row="3"
                    Margin="0,2,0,6"
                    Padding="4"
                    BorderBrush="Gray"
                    BorderThickness="1">
                    <ItemsControl
                        MaxHeight="90"
                        ItemsSource="{Binding AvailableTopics}"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox
                                    Margin="4,2"
                                    Content="{Binding Name}"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                    ToolTip="Documents are grouped and searched by topic." />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <TextBlock
                    Grid.Row="4"
                    Margin="0,2,0,0"
                    FontWeight="Bold"
                    Text="Text (required)" />
                <TextBox
                    Grid.Row="5"
                    Margin="0,2,0,0"
                    AcceptsReturn="True"
                    Text="{Binding NewText, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    ToolTip="The full document content to ingest and index."
                    VerticalScrollBarVisibility="Auto" />
                <StackPanel
                    Grid.Row="6"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Padding="8,4"
                        Click="LoadTextFromFile_Click"
                        Content="Load from .txt file…"
                        ToolTip="Populate the text box with the contents of a .txt file." />
                    <Button
                        Margin="8,0,0,0"
                        Padding="10,4"
                        Click="AddDocument_Click"
                        Content="Add Document" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
