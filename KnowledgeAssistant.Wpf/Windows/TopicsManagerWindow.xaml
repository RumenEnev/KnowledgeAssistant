<Window
    x:Class="KnowledgeAssistant.Wpf.Windows.TopicsManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Manage Topics"
    Width="420"
    Height="560"
    Loaded="TopicsManagerWindow_Loaded"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TreeView
            x:Name="topicsTree"
            Grid.Row="0"
            Margin="0,0,0,8"
            AllowDrop="True"
            DragOver="TopicsTree_DragOver"
            Drop="TopicsTree_Drop"
            ItemsSource="{Binding RootTopics}">
            <TreeView.ItemContainerStyle>
                <Style TargetType="{x:Type TreeViewItem}">
                    <Setter Property="AllowDrop" Value="True" />
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TreeViewItem_PreviewMouseLeftButtonDown" />
                    <EventSetter Event="PreviewMouseMove" Handler="TreeViewItem_PreviewMouseMove" />
                    <EventSetter Event="DragOver" Handler="TreeViewItem_DragOver" />
                    <EventSetter Event="Drop" Handler="TreeViewItem_Drop" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Margin="0,2" Orientation="Horizontal">
                        <TextBlock
                            MinWidth="140"
                            VerticalAlignment="Center"
                            Text="{Binding Name}" />
                        <Button
                            Margin="8,0,0,0"
                            Padding="8,2"
                            Click="EditTopic_Click"
                            Content="Edit"
                            Tag="{Binding}" />
                        <Button
                            Margin="4,0,0,0"
                            Padding="8,2"
                            Click="DeleteTopic_Click"
                            Content="Delete"
                            Tag="{Binding}" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <GroupBox
            Grid.Row="1"
            Margin="0,0,0,8"
            Header="{Binding FormHeader}">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox
                    Grid.Row="0"
                    Margin="0,2,0,6"
                    Text="{Binding NewTopicName, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="A short, descriptive topic name." />

                <ComboBox
                    Grid.Row="1"
                    Margin="0,0,0,6"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{Binding ParentOptions}"
                    SelectedValue="{Binding SelectedParentId}"
                    SelectedValuePath="Id"
                    ToolTip="Choose a parent topic, or leave as top level." />

                <StackPanel
                    Grid.Row="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Margin="0,0,8,0"
                        Padding="10,4"
                        Click="CancelEdit_Click"
                        Content="Cancel"
                        Visibility="{Binding CancelButtonVisibility}" />
                    <Button
                        Padding="10,4"
                        Click="SubmitTopic_Click"
                        Content="{Binding SubmitButtonText}"
                        IsEnabled="{Binding CanSubmit}" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>