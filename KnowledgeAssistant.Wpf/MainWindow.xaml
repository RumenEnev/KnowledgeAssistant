<Window
    x:Class="KnowledgeAssistant.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:KnowledgeAssistant.Wpf.UserControls"
    Title="Knowledge Assistant"
    Width="800"
    Height="500"
    Loaded="MainWindow_Loaded"
    WindowState="Maximized">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80*" />
            <ColumnDefinition Width="103*" />
            <ColumnDefinition Width="217*" />
        </Grid.ColumnDefinitions>

        <Grid
            Grid.Row="0"
            Grid.Column="0"
            Margin="2,2,2,2">
            <TextBlock
                Margin="2"
                HorizontalAlignment="Stretch"
                Text="Conversations" />
            <Button
                Width="20"
                Height="20"
                Margin="2"
                Padding="0,0,0,5"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="CreateConversation_Click"
                Content="+"
                ToolTip="Add conversation" />
        </Grid>

        <ListBox
            Grid.Row="1"
            Grid.RowSpan="3"
            Grid.Column="0"
            Margin="2,2,2,2"
            DisplayMemberPath="Title"
            ItemsSource="{Binding Conversations}"
            SelectedItem="{Binding SelectedConversation}">
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Click="RenameConversation_Click" Header="Rename" />
                    <MenuItem Click="DeleteConversation_Click" Header="Delete" />
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>

        <ComboBox
            Grid.Row="0"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Margin="2,2,2,2"
            ItemsSource="{Binding Models}"
            SelectedItem="{Binding SelectedModel}" />

        <ListView
            Grid.Row="1"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Margin="2,2,2,2"
            ItemsSource="{Binding ChatMessages}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Margin" Value="{Binding ChatMessageMargin}" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <TextBox
            Grid.Row="2"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Margin="2,2,2,2"
            Text="{Binding UserPrompt, UpdateSourceTrigger=PropertyChanged}" />

        <Button
            Grid.Row="3"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Margin="2,2,2,2"
            Click="Send_Click"
            Content="Send" />

        <StatusBar
            Grid.Row="4"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>