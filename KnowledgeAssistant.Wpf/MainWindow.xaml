<Window
    x:Class="KnowledgeAssistant.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:KnowledgeAssistant.Wpf.UserControls"
    Title="Knowledge Assistant"
    Width="800"
    Height="500"
    Loaded="MainWindow_Loaded"
    WindowState="Maximized">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80*" />
            <ColumnDefinition Width="103*" />
            <ColumnDefinition Width="217*" />
        </Grid.ColumnDefinitions>

        <Menu
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="3">
            <MenuItem Header="_File">
                <MenuItem Click="CreateConversation_Click" Header="_New Conversation" />
                <MenuItem Click="RefreshConversation_Click" Header="_Refresh Conversation" />
                <Separator />
                <MenuItem Click="Exit_Click" Header="E_xit" />
            </MenuItem>
            <MenuItem Header="_Settings">
                <MenuItem Click="ManageDocuments_Click" Header="_Documents" />
                <MenuItem Click="ManageModelContextWindows_Click" Header="_Model Context Windows" />
            </MenuItem>
        </Menu>

        <Grid
            Grid.Row="1"
            Grid.Column="0"
            Margin="2">
            <TextBlock
                Margin="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="Bold"
                Text="Conversations" />
            <Button
                Width="20"
                Height="20"
                Margin="2"
                Padding="0,-5,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="CreateConversation_Click"
                Content="+"
                FontSize="16"
                FontWeight="Bold"
                ToolTip="Add conversation" />
        </Grid>

        <ListBox
            Grid.Row="2"
            Grid.RowSpan="3"
            Grid.Column="0"
            Margin="2"
            ItemsSource="{Binding Conversations}"
            SelectedItem="{Binding SelectedConversation}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,2">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <Border
                            x:Name="TopicBadge"
                            Margin="0,2,0,0"
                            Padding="4,0"
                            HorizontalAlignment="Left"
                            Background="#EEF1F5"
                            CornerRadius="3">
                            <TextBlock
                                FontSize="10"
                                Foreground="#555555"
                                Text="{Binding Topic}" />
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Topic}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Topic}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Click="RenameConversation_Click" Header="Rename" />
                    <MenuItem Click="DeleteConversation_Click" Header="Delete" />
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>

        <ComboBox
            Grid.Row="1"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Margin="2"
            ItemsSource="{Binding Models}"
            SelectedItem="{Binding SelectedModel}" />

        <ListView
            Grid.Row="2"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Margin="2"
            ItemsSource="{Binding ChatMessages}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Margin" Value="{Binding ChatMessageMargin}" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <TextBox
            Grid.Row="3"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Margin="2,2,2,2"
            KeyDown="UserPrompt_KeyDown"
            Text="{Binding UserPrompt, UpdateSourceTrigger=PropertyChanged}" />

        <Button
            Grid.Row="4"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Margin="2,2,2,2"
            Click="Send_Click"
            Content="Send" />

        <StatusBar
            Grid.Row="5"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>