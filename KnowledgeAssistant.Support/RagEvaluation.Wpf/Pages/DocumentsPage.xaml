<Page
    x:Class="RagEvaluation.Desktop.Pages.DocumentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Documents"
    d:DesignHeight="700"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Text="Documents" />
            <TextBlock
                Margin="0,4,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Import files, inspect how they were chunked, and generate vectors per embedding model."
                TextWrapping="Wrap" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <ui:Button
                Margin="0,0,8,8"
                Padding="12,6"
                Appearance="Primary"
                Click="ImportButton_Click"
                Content="Import…"
                Icon="{ui:SymbolIcon ArrowImport24}"
                IsEnabled="{Binding IsIdle}" />
            <ui:Button
                Margin="0,0,24,8"
                Padding="12,6"
                Click="RechunkButton_Click"
                Content="Re-chunk…"
                Icon="{ui:SymbolIcon DocumentSplitHint24}"
                IsEnabled="{Binding IsIdle}" />

            <TextBlock
                Margin="0,0,8,8"
                VerticalAlignment="Center"
                Text="Embedding model" />
            <ComboBox
                MinWidth="200"
                Margin="0,0,8,8"
                IsEnabled="{Binding IsIdle}"
                ItemsSource="{Binding EmbeddingModels}"
                SelectedItem="{Binding SelectedEmbeddingModel}" />
            <ui:Button
                Margin="0,0,8,8"
                Padding="12,6"
                Command="{Binding GenerateVectorsForSelectedCommand}"
                Content="Vectors: selected"
                Icon="{ui:SymbolIcon BracesVariable24}"
                IsEnabled="{Binding CanActOnSelection}" />
            <ui:Button
                Margin="0,0,24,8"
                Padding="12,6"
                Command="{Binding GenerateVectorsForAllCommand}"
                Content="Vectors: all"
                Icon="{ui:SymbolIcon BracesVariable24}"
                IsEnabled="{Binding IsIdle}" />

            <ui:Button
                Margin="0,0,8,8"
                Padding="12,6"
                Appearance="Danger"
                Click="DeleteButton_Click"
                Content="Delete"
                Icon="{ui:SymbolIcon Delete24}"
                IsEnabled="{Binding CanActOnSelection}" />
            <ui:Button
                Margin="0,0,8,8"
                Padding="12,6"
                Command="{Binding RefreshCommand}"
                Content="Refresh"
                Icon="{ui:SymbolIcon ArrowSync24}"
                IsEnabled="{Binding IsIdle}" />
            <ui:Button
                Margin="0,0,8,8"
                Padding="12,6"
                Command="{Binding CancelOperationCommand}"
                Content="Cancel"
                Icon="{ui:SymbolIcon Dismiss24}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </WrapPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="280" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="3*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <DataGrid
                Grid.Column="0"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding Documents}"
                SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="2*"
                        Binding="{Binding Title}"
                        Header="Title" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Topics}"
                        Header="Topics" />
                    <DataGridTextColumn
                        Width="64"
                        Binding="{Binding ChunkCount}"
                        Header="Chunks" />
                    <DataGridTextColumn
                        Width="90"
                        Binding="{Binding Created}"
                        Header="Created" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter
                Grid.Column="1"
                Width="8"
                HorizontalAlignment="Stretch"
                Background="Transparent" />

            <TabControl Grid.Column="2">
                <TabItem Header="Chunks">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="160" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Margin="0,0,0,8"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding ChunkingSummary}"
                            TextWrapping="Wrap" />

                        <DataGrid
                            Grid.Row="1"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding Chunks}"
                            SelectedItem="{Binding SelectedChunk, Mode=TwoWay}"
                            SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="44"
                                    Binding="{Binding Index}"
                                    Header="#" />
                                <DataGridTextColumn
                                    Width="64"
                                    Binding="{Binding Chars}"
                                    Header="Chars" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Preview}"
                                    Header="Text" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel
                            Grid.Row="2"
                            Margin="0,8,0,8"
                            Orientation="Horizontal">
                            <ui:Button
                                Margin="0,0,8,0"
                                Padding="12,6"
                                Click="EditChunkButton_Click"
                                Content="Edit chunk…"
                                Icon="{ui:SymbolIcon Edit24}"
                                IsEnabled="{Binding CanActOnChunk}" />
                            <ui:Button
                                Padding="12,6"
                                Click="DeleteChunkButton_Click"
                                Content="Delete chunk"
                                Icon="{ui:SymbolIcon Delete24}"
                                IsEnabled="{Binding CanActOnChunk}" />
                        </StackPanel>

                        <TextBox
                            Grid.Row="3"
                            AcceptsReturn="True"
                            FontFamily="Consolas"
                            IsReadOnly="True"
                            Text="{Binding SelectedChunk.Text, Mode=OneWay}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </TabItem>

                <TabItem Header="Source text">
                    <TextBox
                        Margin="0,8,0,0"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        IsReadOnly="True"
                        Text="{Binding SelectedSourceText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                </TabItem>
            </TabControl>
        </Grid>

        <!--  Progress + status  -->
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <ProgressBar
                Margin="0,0,0,6"
                Maximum="{Binding ProgressMax}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                Value="{Binding ProgressValue, Mode=OneWay}" />
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>