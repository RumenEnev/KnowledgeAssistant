<Page
    x:Class="RagEvaluation.Desktop.Pages.ChunkDocumentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Chunk Document"
    d:DesignHeight="700"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                CanVerticallyScroll="True">
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="Chunk Document" />
                <TextBlock
                    Margin="0,0,0,16"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Creates a new document, splits it into chunks and generates embeddings for it - the same ingestion pipeline used by the Knowledge Assistant app."
                    TextWrapping="Wrap" />

                <ui:Card Margin="0,0,0,16" Padding="16">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,4" Text="Title" />
                        <ui:TextBox
                            x:Name="TitleBox"
                            Margin="0,0,0,12"
                            PlaceholderText="A short, descriptive name for the document" />

                        <TextBlock Margin="0,0,0,4" Text="Topics (select at least one)" />
                        <Border
                            MaxHeight="140"
                            Margin="0,0,0,12"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <ListBox
                                x:Name="TopicsList"
                                BorderThickness="0"
                                ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Margin="4,2"
                                            Content="{Binding Name}"
                                            IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <TextBlock Margin="0,0,0,4" Text="Document type" />
                        <ComboBox
                            x:Name="DocumentTypeSelector"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Left" />

                        <TextBlock Margin="0,0,0,4" Text="Embedding model" />
                        <ComboBox
                            x:Name="ModelSelector"
                            MinWidth="240"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Left" />

                        <TextBlock Margin="0,0,0,4" Text="Chunk size (chars)" />
                        <ui:NumberBox
                            x:Name="ChunkSizeBox"
                            Width="200"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Left"
                            Value="1200" />

                        <TextBlock Margin="0,0,0,4" Text="Chunk overlap (chars)" />
                        <ui:NumberBox
                            x:Name="ChunkOverlapBox"
                            Width="200"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Left"
                            Value="200" />

                        <TextBlock Margin="0,0,0,4" Text="Text" />
                        <ui:TextBox
                            x:Name="TextBox"
                            Height="200"
                            AcceptsReturn="True"
                            PlaceholderText="The full document content to ingest and chunk"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />

                        <ui:Button
                            x:Name="LoadFromFileButton"
                            Margin="0,8,0,0"
                            Padding="12,6"
                            HorizontalAlignment="Left"
                            Click="LoadFromFileButton_Click"
                            Content="Load from file…"
                            Icon="{ui:SymbolIcon FolderOpen24}" />
                    </StackPanel>
                </ui:Card>

                <ui:Button
                    x:Name="ChunkButton"
                    Padding="16,8"
                    HorizontalAlignment="Left"
                    Appearance="Primary"
                    Click="ChunkButton_Click"
                    Content="Chunk Document" />

                <ui:ProgressRing
                    x:Name="ProgressRing"
                    Width="24"
                    Height="24"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Left"
                    IsIndeterminate="True"
                    Visibility="Collapsed" />

                <TextBlock
                    x:Name="ResultText"
                    Margin="0,16,0,0"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="2" HorizontalAlignment="Stretch">
                <StackPanel
                    Margin="0,0,0,8"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Existing Documents" />
                    <ui:Button
                        x:Name="RefreshDocumentsButton"
                        Margin="12,0,0,0"
                        Padding="10,4"
                        Click="RefreshDocumentsButton_Click"
                        Content="Refresh"
                        Icon="{ui:SymbolIcon ArrowSync24}" />
                </StackPanel>

                <DataGrid
                    x:Name="DocumentsGrid"
                    Height="360"
                    Margin="0,0,0,8"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    SelectionChanged="DocumentsGrid_SelectionChanged"
                    SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="40"
                            Binding="{Binding Id}"
                            Header="Id" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Title}"
                            Header="Title" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding TopicsDisplay}"
                            Header="Topics" />
                    </DataGrid.Columns>
                </DataGrid>

                <ui:Card Margin="0,0,0,8" Padding="12">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,4"
                            FontWeight="SemiBold"
                            Text="Chunking Parameters" />
                        <TextBlock
                            x:Name="ChunkingParamsText"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Select a document to view the chunking settings that apply to it."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <ui:Button
                    x:Name="DeleteDocumentButton"
                    Padding="12,6"
                    HorizontalAlignment="Left"
                    Appearance="Danger"
                    Click="DeleteDocumentButton_Click"
                    Content="Delete"
                    Icon="{ui:SymbolIcon Delete24}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>