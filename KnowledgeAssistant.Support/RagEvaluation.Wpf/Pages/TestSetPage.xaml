<Page
    x:Class="RagEvaluation.Desktop.Pages.TestSetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Test set"
    d:DesignHeight="700"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Text="Test set" />
            <TextBlock
                Margin="0,4,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="These questions are the ground truth every run is scored against. Review them: select a question to see the passage it is supposed to find, and delete the ones that are bad."
                TextWrapping="Wrap" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,4">
            <ui:Button
                Margin="0,0,8,8"
                Padding="12,6"
                Appearance="Primary"
                Click="GenerateButton_Click"
                Content="Generate…"
                Icon="{ui:SymbolIcon DocumentAdd24}"
                IsEnabled="{Binding IsIdle}" />
            <ui:Button
                Margin="0,0,8,8"
                Padding="12,6"
                Appearance="Danger"
                Click="DeleteSelectedButton_Click"
                Content="Delete selected"
                Icon="{ui:SymbolIcon Delete24}"
                IsEnabled="{Binding CanDeleteSelection}" />
            <ui:Button
                Margin="0,0,24,8"
                Padding="12,6"
                Click="DeleteOrphansButton_Click"
                Content="Delete orphaned"
                Icon="{ui:SymbolIcon Delete24}"
                IsEnabled="{Binding CanDeleteOrphans}" />

            <TextBlock
                Margin="0,0,8,8"
                VerticalAlignment="Center"
                Text="Show" />
            <ComboBox
                MinWidth="220"
                Margin="0,0,24,8"
                DisplayMemberPath="Title"
                IsEnabled="{Binding IsIdle}"
                ItemsSource="{Binding DocumentFilters}"
                SelectedItem="{Binding SelectedFilter}" />

            <ui:Button
                Margin="0,0,8,8"
                Padding="12,6"
                Command="{Binding RefreshCommand}"
                Content="Refresh"
                Icon="{ui:SymbolIcon ArrowSync24}"
                IsEnabled="{Binding IsIdle}" />
            <ui:Button
                Margin="0,0,8,8"
                Padding="12,6"
                Command="{Binding CancelOperationCommand}"
                Content="Cancel"
                Icon="{ui:SymbolIcon Dismiss24}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </WrapPanel>

        <TextBlock
            Grid.Row="2"
            Margin="0,0,0,8"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding SummaryText}"
            TextWrapping="Wrap" />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="360" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="2*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <DataGrid
                x:Name="QuestionsGrid"
                Grid.Column="0"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding Questions}"
                SelectionChanged="QuestionsGrid_SelectionChanged"
                SelectionMode="Extended">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="3*"
                        Binding="{Binding Question}"
                        Header="Question" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Document}"
                        Header="Document" />
                    <DataGridTextColumn
                        Width="90"
                        Binding="{Binding Topic}"
                        Header="Topic" />
                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding Status}"
                        Header="Status" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter
                Grid.Column="1"
                Width="8"
                HorizontalAlignment="Stretch"
                Background="Transparent" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,4"
                    FontWeight="SemiBold"
                    Text="Question" />
                <TextBox
                    Grid.Row="1"
                    MaxHeight="120"
                    Margin="0,0,0,12"
                    IsReadOnly="True"
                    Text="{Binding SelectedQuestionText, Mode=OneWay}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
                <TextBlock
                    Grid.Row="2"
                    Margin="0,0,0,4"
                    FontWeight="SemiBold"
                    Text="Passage it should find" />
                <TextBox
                    Grid.Row="3"
                    AcceptsReturn="True"
                    FontFamily="Consolas"
                    IsReadOnly="True"
                    Text="{Binding ExpectedPassages, Mode=OneWay}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <ProgressBar
                Margin="0,0,0,6"
                Maximum="{Binding ProgressMax}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                Value="{Binding ProgressValue, Mode=OneWay}" />
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>