<Page
    x:Class="RagEvaluation.Desktop.Pages.GenerateTestSetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Generate Test Set"
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="24"
                FontWeight="SemiBold"
                Text="Generate Test Set" />
            <TextBlock
                Margin="0,0,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Generates synthetic test queries (one per chunk x topic) using the configured generator model. Hand-review a sample and mix in real user queries before trusting retrieval scores from this set alone."
                TextWrapping="Wrap" />

            <ui:Card Margin="0,0,0,16" Padding="16">
                <StackPanel>
                    <TextBlock Margin="0,0,0,4" Text="Questions per chunk" />
                    <ui:NumberBox
                        x:Name="QuestionsPerChunkBox"
                        Width="200"
                        HorizontalAlignment="Left"
                        Value="1" />

                    <TextBlock Margin="0,0,0,4" Text="Document (optional - leave as 'All Documents' to generate for the whole corpus)" />
                    <ComboBox
                        x:Name="DocumentSelector"
                        Margin="0,0,0,12"
                        DisplayMemberPath="Title" />
                </StackPanel>
            </ui:Card>

            <ui:Button
                x:Name="GenerateButton"
                Padding="16,8"
                HorizontalAlignment="Left"
                Appearance="Primary"
                Click="GenerateButton_Click"
                Content="Generate" />

            <ui:ProgressRing
                x:Name="ProgressRing"
                Width="24"
                Height="24"
                Margin="0,16,0,0"
                HorizontalAlignment="Left"
                IsIndeterminate="False"
                Visibility="Collapsed" />

            <TextBlock
                x:Name="ProgressText"
                Margin="0,8,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <TextBlock
                x:Name="ResultText"
                Margin="0,16,0,0"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
