<Page
    x:Class="RagEvaluation.Desktop.Pages.MetricsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Metrics"
    d:DesignHeight="800"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Text="Metrics" />
            <TextBlock
                Margin="0,4,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Mean retrieval and answer scores for a run, and the score of every question."
                TextWrapping="Wrap" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,4">
            <TextBlock
                Margin="0,0,8,8"
                VerticalAlignment="Center"
                Text="Run" />
            <ComboBox
                Width="320"
                Margin="0,0,24,8"
                DisplayMemberPath="RunName"
                IsEnabled="{Binding IsIdle}"
                ItemsSource="{Binding Runs}"
                SelectedItem="{Binding SelectedRun}" />
            <ui:Button
                Margin="0,0,8,8"
                Padding="12,6"
                Command="{Binding RefreshCommand}"
                Content="Refresh"
                Icon="{ui:SymbolIcon ArrowSync24}"
                IsEnabled="{Binding IsIdle}" />
            <ui:Button
                Margin="0,0,8,8"
                Padding="12,6"
                Click="ExportButton_Click"
                Content="Export CSV"
                Icon="{ui:SymbolIcon ArrowExport24}"
                IsEnabled="{Binding CanExport}" />
            <ui:Button
                Margin="0,0,8,8"
                Padding="12,6"
                Click="ExportSummaryButton_Click"
                Content="Export summary"
                Icon="{ui:SymbolIcon ArrowExport24}"
                IsEnabled="{Binding CanExport}" />
            <ui:Button
                Margin="0,0,8,8"
                Padding="12,6"
                Appearance="Danger"
                Click="DeleteButton_Click"
                Content="Delete run"
                Icon="{ui:SymbolIcon Delete24}"
                IsEnabled="{Binding CanExport}" />
        </WrapPanel>

        <DataGrid
            Grid.Row="2"
            MaxHeight="240"
            Margin="0,0,0,12"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserSortColumns="False"
            GridLinesVisibility="Horizontal"
            HeadersVisibility="Column"
            IsReadOnly="True"
            ItemsSource="{Binding Summary}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Metric}"
                    Header="Metric (mean for the run)" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding Value}"
                    Header="Value" />
            </DataGrid.Columns>
        </DataGrid>

        <DataGrid
            x:Name="QueryMetricsGrid"
            Grid.Row="3"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            EnableColumnVirtualization="True"
            EnableRowVirtualization="True"
            GridLinesVisibility="Horizontal"
            HeadersVisibility="Column"
            IsReadOnly="True"
            ItemsSource="{Binding QueryMetrics}"
            MouseDoubleClick="QueryMetricsGrid_MouseDoubleClick"
            SelectionMode="Single"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="3*"
                    Binding="{Binding QueryText}"
                    Header="Question">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="ToolTip" Value="{Binding QueryText}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding PrecisionAtK, StringFormat={}{0:F3}}"
                    Header="Precision" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding RecallAtK, StringFormat={}{0:F3}}"
                    Header="Recall" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding ReciprocalRank, StringFormat={}{0:F3}}"
                    Header="MRR" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding NdcgAtK, StringFormat={}{0:F3}}"
                    Header="NDCG" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding FaithfulnessScore, StringFormat={}{0:F2}}"
                    Header="Faithfulness" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding RelevanceScore, StringFormat={}{0:F2}}"
                    Header="Relevance" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding CompletenessScore, StringFormat={}{0:F2}}"
                    Header="Completeness" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <ProgressBar
                Height="3"
                Margin="0,0,0,6"
                IsIndeterminate="True"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
