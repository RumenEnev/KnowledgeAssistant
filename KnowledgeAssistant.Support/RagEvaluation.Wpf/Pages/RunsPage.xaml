<Page
    x:Class="RagEvaluation.Desktop.Pages.RunsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Runs"
    d:DesignHeight="700"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Text="Runs" />
            <TextBlock
                Margin="0,4,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Every evaluation run so far. Select a run to see its summary."
                TextWrapping="Wrap" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,4">
            <ui:Button
                Margin="0,0,8,8"
                Padding="12,6"
                Command="{Binding RefreshCommand}"
                Content="Refresh"
                Icon="{ui:SymbolIcon ArrowSync24}"
                IsEnabled="{Binding IsIdle}" />
            <ui:Button
                Margin="0,0,8,8"
                Padding="12,6"
                Appearance="Danger"
                Click="CleanDatabaseButton_Click"
                Content="Clean database"
                Icon="{ui:SymbolIcon Delete24}"
                IsEnabled="{Binding IsIdle}" />
            <ui:Button
                Margin="0,0,8,8"
                Padding="12,6"
                Command="{Binding CancelOperationCommand}"
                Content="Cancel"
                Icon="{ui:SymbolIcon Dismiss24}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </WrapPanel>

        <TextBlock
            Grid.Row="2"
            Margin="0,0,0,8"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding SummaryText}"
            TextWrapping="Wrap" />

        <DataGrid
            Grid.Row="3"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            GridLinesVisibility="Horizontal"
            HeadersVisibility="Column"
            IsReadOnly="True"
            ItemsSource="{Binding Runs}"
            SelectedItem="{Binding SelectedRun, Mode=TwoWay}"
            SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="60"
                    Binding="{Binding Id}"
                    Header="Id" />
                <DataGridTextColumn
                    Width="2*"
                    Binding="{Binding RunName}"
                    Header="Run name" />
                <DataGridTextColumn
                    Width="110"
                    Binding="{Binding ChatProvider}"
                    Header="Chat provider" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding ChatModel}"
                    Header="Chat model" />
                <DataGridTextColumn
                    Width="110"
                    Binding="{Binding JudgeProvider}"
                    Header="Judge provider" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding JudgeModel}"
                    Header="Judge model" />
                <DataGridTextColumn
                    Width="160"
                    Binding="{Binding CreatedAt}"
                    Header="Created" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock
            Grid.Row="4"
            Margin="0,12,0,0"
            FontFamily="Consolas"
            Text="{Binding DetailText}"
            TextWrapping="Wrap" />

        <StackPanel Grid.Row="5" Margin="0,12,0,0">
            <ProgressBar
                Margin="0,0,0,6"
                Maximum="{Binding ProgressMax}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                Value="{Binding ProgressValue, Mode=OneWay}" />
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
