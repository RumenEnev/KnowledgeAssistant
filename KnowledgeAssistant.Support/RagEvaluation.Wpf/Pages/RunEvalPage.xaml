<Page
    x:Class="RagEvaluation.Desktop.Pages.RunEvalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Run Evaluation"
    d:DesignHeight="700"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="24"
                FontWeight="SemiBold"
                Text="Run Evaluation" />

            <ui:Card Margin="0,0,0,16" Padding="16">
                <StackPanel>
                    <TextBlock Margin="0,0,0,4" Text="Run name" />
                    <ui:TextBox
                        x:Name="RunNameBox"
                        Margin="0,0,0,12"
                        PlaceholderText="run-YYYYMMDD-HHmmss (leave blank to auto-generate)" />

                    <TextBlock Margin="0,0,0,4" Text="Chat model" />
                    <ui:TextBox x:Name="ChatModelBox" Margin="0,0,0,12" />

                    <TextBlock Margin="0,0,0,4" Text="Embedding model" />
                    <ui:TextBox x:Name="EmbeddingModelBox" Margin="0,0,0,12" />

                    <TextBlock Margin="0,0,0,4" Text="Judge model" />
                    <ui:TextBox x:Name="JudgeModelBox" />
                </StackPanel>
            </ui:Card>

            <ui:Button
                x:Name="RunButton"
                Padding="16,8"
                HorizontalAlignment="Left"
                Appearance="Primary"
                Click="RunButton_Click"
                Content="Run Evaluation" />

            <ProgressBar
                x:Name="ProgressBarControl"
                Margin="0,16,0,0"
                Maximum="1"
                Visibility="Collapsed" />

            <TextBlock
                x:Name="ProgressText"
                Margin="0,4,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis" />

            <TextBlock
                x:Name="ResultText"
                Margin="0,16,0,0"
                FontFamily="Consolas"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
