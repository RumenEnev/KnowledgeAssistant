<Page
    x:Class="RagEvaluation.Desktop.Pages.RunEvalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Run Evaluation"
    d:DesignHeight="700"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="24"
                FontWeight="SemiBold"
                Text="Run Evaluation" />

            <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                <ui:Card
                    Width="340"
                    Padding="16"
                    VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,4" Text="Run name" />
                        <ui:TextBox
                            x:Name="RunNameBox"
                            Margin="0,0,0,12"
                            PlaceholderText="run-YYYYMMDD-HHmmss (leave blank to auto-generate)" />

                        <TextBlock Margin="0,0,0,4" Text="Chat model" />
                        <ui:TextBox x:Name="ChatModelBox" Margin="0,0,0,12" />

                        <TextBlock Margin="0,0,0,4" Text="Embedding model" />
                        <ui:TextBox x:Name="EmbeddingModelBox" Margin="0,0,0,12" />

                        <TextBlock Margin="0,0,0,4" Text="Judge model" />
                        <ui:TextBox x:Name="JudgeModelBox" />

                        <TextBlock Margin="0,0,0,4" Text="Document (optional - leave as 'All Documents' to run the full test set)" />
                        <ComboBox
                            x:Name="DocumentSelector"
                            Margin="0,0,0,12"
                            DisplayMemberPath="Title"
                            SelectionChanged="DocumentSelector_SelectionChanged" />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    x:Name="RetrievalSettingsCard"
                    Width="340"
                    Margin="16,0,0,0"
                    Padding="16"
                    VerticalAlignment="Top"
                    Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,4"
                            FontWeight="SemiBold"
                            Text="Retrieval Settings (this document)" />
                        <TextBlock
                            Margin="0,0,0,12"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Applies immediately to the next eval run for this document. Chunk size/overlap are managed in the Documents app." />

                        <TextBlock Margin="0,0,0,4" Text="Candidate pool size" />
                        <ui:NumberBox x:Name="PoolSizeBox" Margin="0,0,0,12" />

                        <TextBlock Margin="0,0,0,4" Text="Candidate fanout" />
                        <ui:NumberBox x:Name="FanoutBox" Margin="0,0,0,12" />

                        <TextBlock Margin="0,0,0,4" Text="Max distance threshold" />
                        <ui:NumberBox x:Name="DistanceThresholdBox" Margin="0,0,0,12" />

                        <TextBlock Margin="0,0,0,4" Text="RRF k" />
                        <ui:NumberBox x:Name="RrfKBox" Margin="0,0,0,12" />

                        <TextBlock Margin="0,0,0,4" Text="Target injection fraction" />
                        <ui:NumberBox x:Name="TargetFractionBox" Margin="0,0,0,12" />

                        <TextBlock Margin="0,0,0,4" Text="Max injection fraction" />
                        <ui:NumberBox x:Name="MaxFractionBox" Margin="0,0,0,12" />

                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <ui:Button
                                x:Name="ResetRetrievalConfigButton"
                                Margin="0,0,8,0"
                                Padding="12,6"
                                Click="ResetRetrievalConfigButton_Click"
                                Content="Reset to Default" />
                            <ui:Button
                                x:Name="SaveRetrievalConfigButton"
                                Padding="12,6"
                                Appearance="Secondary"
                                Click="SaveRetrievalConfigButton_Click"
                                Content="Save Settings" />
                        </StackPanel>

                        <TextBlock
                            x:Name="RetrievalConfigStatusText"
                            Margin="0,8,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <ui:Button
                x:Name="RunButton"
                Padding="16,8"
                HorizontalAlignment="Left"
                Appearance="Primary"
                Click="RunButton_Click"
                Content="Run Evaluation" />

            <ProgressBar
                x:Name="ProgressBarControl"
                Margin="0,16,0,0"
                Maximum="1"
                Visibility="Collapsed" />

            <TextBlock
                x:Name="ProgressText"
                Margin="0,4,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis" />

            <TextBlock
                x:Name="ResultText"
                Margin="0,16,0,0"
                FontFamily="Consolas"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>