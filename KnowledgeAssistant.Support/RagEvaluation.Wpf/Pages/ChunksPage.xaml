<Page
    x:Class="RagEvaluation.Desktop.Pages.ChunksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Chunks"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,16"
            FontSize="24"
            FontWeight="SemiBold"
            Text="Document Chunks" />

        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,8"
            HorizontalAlignment="Left"
            Orientation="Horizontal">
            <ui:TextBox
                x:Name="SearchBox"
                Width="300"
                VerticalAlignment="Center"
                KeyDown="SearchBox_KeyDown"
                PlaceholderText="Search chunk text..." />
            <ui:Button
                x:Name="SearchButton"
                Margin="8,0,0,0"
                Padding="12,6"
                Click="SearchButton_Click"
                Content="Search"
                Icon="{ui:SymbolIcon Search24}" />
            <ui:Button
                x:Name="RefreshButton"
                Margin="8,0,0,0"
                Padding="12,6"
                Click="RefreshButton_Click"
                Content="Refresh"
                Icon="{ui:SymbolIcon ArrowSync24}" />
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            Margin="0,0,0,12"
            HorizontalAlignment="Left"
            Orientation="Horizontal">
            <ui:Button
                x:Name="EditButton"
                Padding="12,6"
                Click="EditButton_Click"
                Content="Edit"
                Icon="{ui:SymbolIcon Edit24}" />
            <ui:Button
                x:Name="DeleteButton"
                Margin="8,0,0,0"
                Padding="12,6"
                Appearance="Danger"
                Click="DeleteButton_Click"
                Content="Delete"
                Icon="{ui:SymbolIcon Delete24}" />
            <ui:Button
                x:Name="PrevPageButton"
                Margin="24,0,0,0"
                Padding="12,6"
                Click="PrevPageButton_Click"
                Content="Previous" />
            <TextBlock
                x:Name="PageText"
                Margin="12,0"
                VerticalAlignment="Center"
                Text="Page 1" />
            <ui:Button
                x:Name="NextPageButton"
                Padding="12,6"
                Click="NextPageButton_Click"
                Content="Next" />
        </StackPanel>

        <DataGrid
            x:Name="ChunksGrid"
            Grid.Row="3"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            SelectionMode="Single"
            SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="60"
                    Binding="{Binding Id}"
                    Header="Id" />
                <DataGridTextColumn
                    Width="70"
                    Binding="{Binding DocumentId}"
                    Header="Doc Id" />
                <DataGridTextColumn
                    Width="200"
                    Binding="{Binding DocumentTitle}"
                    Header="Document" />
                <DataGridTextColumn
                    Width="60"
                    Binding="{Binding ChunkIndex}"
                    Header="Index" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding ChunkText}"
                    Header="Chunk Text" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="4"
            Margin="0,12,0,0"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
    </Grid>
</Page>