<ui:FluentWindow
    x:Class="RagEvaluation.Desktop.Windows.IngestOptionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Documents"
    Width="560"
    MaxHeight="820"
    ExtendsContentIntoTitleBar="True"
    SizeToContent="Height"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="DialogTitleBar"
            Grid.Row="0"
            ShowMaximize="False"
            ShowMinimize="False" />

        <ScrollViewer
            Grid.Row="1"
            Padding="24,8,24,8"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock
                    x:Name="HeadingText"
                    Margin="0,0,0,16"
                    FontSize="20"
                    FontWeight="SemiBold" />

                <!--  Import only  -->
                <StackPanel x:Name="ImportSection">
                    <TextBlock Margin="0,0,0,4" Text="Files (.md or .txt)" />
                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                        <ui:Button
                            Padding="12,6"
                            Click="ChooseFilesButton_Click"
                            Content="Choose files…"
                            Icon="{ui:SymbolIcon FolderOpen24}" />
                        <TextBlock
                            x:Name="FilesText"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="No files selected"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock Margin="0,0,0,4" Text="Topics (select at least one - applied to every imported file)" />
                    <Border
                        MaxHeight="140"
                        Margin="0,0,0,12"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ListBox
                            x:Name="TopicsList"
                            BorderThickness="0"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        Margin="4,2"
                                        Content="{Binding Name}"
                                        IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>

                <!--  Re-chunk only  -->
                <StackPanel x:Name="RechunkSection">
                    <TextBlock Margin="0,0,0,4" Text="Which documents" />
                    <StackPanel Margin="0,0,0,12">
                        <RadioButton
                            x:Name="ScopeSelectedRadio"
                            Checked="Scope_Changed"
                            Content="Selected document"
                            GroupName="Scope" />
                        <RadioButton
                            x:Name="ScopeAllRadio"
                            Checked="Scope_Changed"
                            Content="All documents"
                            GroupName="Scope" />
                    </StackPanel>

                    <TextBlock Margin="0,0,0,4" Text="Document type (decides how the text is split)" />
                    <ComboBox
                        x:Name="TypeSelector"
                        MinWidth="200"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Left" />
                </StackPanel>

                <!--  Both  -->
                <TextBlock Margin="0,0,0,4" Text="Embedding model" />
                <ComboBox
                    x:Name="ModelSelector"
                    MinWidth="240"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Left" />

                <TextBlock Margin="0,0,0,4" Text="Chunk size (chars)" />
                <ui:NumberBox
                    x:Name="ChunkSizeBox"
                    Width="200"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Left" />

                <TextBlock Margin="0,0,0,4" Text="Chunk overlap (chars)" />
                <ui:NumberBox
                    x:Name="ChunkOverlapBox"
                    Width="200"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Left" />

                <ui:Card
                    x:Name="WarningCard"
                    Margin="0,0,0,12"
                    Padding="12">
                    <TextBlock x:Name="WarningText" TextWrapping="Wrap" />
                </ui:Card>

                <TextBlock
                    x:Name="ErrorText"
                    Margin="0,0,0,8"
                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            Margin="24,8,24,20"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                Margin="0,0,8,0"
                Padding="16,8"
                Content="Cancel"
                IsCancel="True" />
            <ui:Button
                x:Name="OkButton"
                Padding="16,8"
                Appearance="Primary"
                Click="OkButton_Click"
                Content="OK"
                IsDefault="True" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>