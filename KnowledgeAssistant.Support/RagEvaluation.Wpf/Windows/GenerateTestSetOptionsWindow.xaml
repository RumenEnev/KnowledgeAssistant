<ui:FluentWindow
    x:Class="RagEvaluation.Desktop.Windows.GenerateTestSetOptionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Generate test questions"
    Width="560"
    MaxHeight="820"
    ExtendsContentIntoTitleBar="True"
    SizeToContent="Height"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="DialogTitleBar"
            Grid.Row="0"
            ShowMaximize="False"
            ShowMinimize="False" />

        <ScrollViewer
            Grid.Row="1"
            Padding="24,8,24,8"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Generate test questions" />

                <TextBlock Margin="0,0,0,4" Text="Documents" />
                <ComboBox
                    x:Name="DocumentSelector"
                    MinWidth="300"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Left"
                    DisplayMemberPath="Title" />

                <TextBlock Margin="0,0,0,4" Text="Provider" />
                <ComboBox
                    x:Name="ProviderSelector"
                    MinWidth="240"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Left"
                    SelectionChanged="ProviderSelector_SelectionChanged" />

                <TextBlock Margin="0,0,0,4" Text="Generator model" />
                <ComboBox
                    x:Name="ModelSelector"
                    MinWidth="300"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Left" />

                <TextBlock Margin="0,0,0,4" Text="Questions per chunk" />
                <ui:NumberBox
                    x:Name="QuestionsPerChunkBox"
                    Width="200"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Left"
                    Maximum="10"
                    Minimum="1" />

                <CheckBox
                    x:Name="SkipExistingCheck"
                    Margin="0,0,0,12"
                    Content="Skip documents that already have questions" />

                <ui:Card Margin="0,0,0,12" Padding="12">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="• Unless you skip them, a document's existing questions are replaced once its new set is complete. Cancelling keeps the old questions of unfinished documents." />
                        <LineBreak />
                        <Run Text="• Each question is saved once per topic of its document, because evaluation retrieves within a topic. A document with 3 topics gets 3 copies of every question." />
                        <LineBreak />
                        <Run Text="• Very short chunks (bare headings) are skipped." />
                    </TextBlock>
                </ui:Card>

                <TextBlock
                    x:Name="ErrorText"
                    Margin="0,0,0,8"
                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            Margin="24,8,24,20"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                Margin="0,0,8,0"
                Padding="16,8"
                Content="Cancel"
                IsCancel="True" />
            <ui:Button
                Padding="16,8"
                Appearance="Primary"
                Click="OkButton_Click"
                Content="Generate"
                IsDefault="True" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>