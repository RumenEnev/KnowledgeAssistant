<ui:FluentWindow
    x:Class="RagEvaluation.Desktop.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="RAG Evaluation"
    Width="1100"
    Height="750"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="RAG Evaluation" Grid.Row="0" />

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True"
            OpenPaneLength="230"
            PaneDisplayMode="Left">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    xmlns:local="clr-namespace:RagEvaluation.Desktop.Pages"
                    Content="Generate Test Set"
                    Tag="generate-testset"
                    TargetPageType="{x:Type local:GenerateTestSetPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DocumentAdd24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem
                    xmlns:local="clr-namespace:RagEvaluation.Desktop.Pages"
                    Content="Run Evaluation"
                    Tag="run-eval"
                    TargetPageType="{x:Type local:RunEvalPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Play24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem
                    xmlns:local="clr-namespace:RagEvaluation.Desktop.Pages"
                    Content="Runs"
                    Tag="list-runs"
                    TargetPageType="{x:Type local:RunsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="List24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem
                    xmlns:local="clr-namespace:RagEvaluation.Desktop.Pages"
                    Content="Metrics"
                    Tag="metrics"
                    TargetPageType="{x:Type local:MetricsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DataHistogram24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem
                    xmlns:local="clr-namespace:RagEvaluation.Desktop.Pages"
                    Content="Chunks"
                    Tag="chunks"
                    TargetPageType="{x:Type local:ChunksPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DocumentBulletList24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
