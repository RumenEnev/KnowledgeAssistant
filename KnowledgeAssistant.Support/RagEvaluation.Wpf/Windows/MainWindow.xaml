<ui:FluentWindow
    x:Class="RagEvaluation.Desktop.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="clr-namespace:RagEvaluation.Desktop.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="RAG Evaluation"
    Width="1100"
    Height="750"
    MinWidth="900"
    MinHeight="600"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="RAG Evaluation" Grid.Row="0" />
        <Border
            x:Name="StatusStrip"
            Grid.Row="1"
            Padding="20,6,12,6"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            BorderThickness="0,1,0,1">
            <DockPanel LastChildFill="True">
                <ui:Button
                    x:Name="RefreshStatusButton"
                    Padding="8,4"
                    Appearance="Transparent"
                    Click="RefreshStatusButton_Click"
                    DockPanel.Dock="Right"
                    Icon="{ui:SymbolIcon ArrowSync24}"
                    ToolTip="Refresh status" />
                <ProgressBar
                    Width="48"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    IsIndeterminate="True"
                    Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel
                                Margin="0,0,28,0"
                                Orientation="Horizontal"
                                ToolTip="{Binding ToolTip}">
                                <TextBlock
                                    Margin="0,0,6,0"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Label}" />
                                <TextBlock FontWeight="SemiBold" Text="{Binding Value}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="2"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True"
            OpenPaneLength="230"
            PaneDisplayMode="Left">
            <ui:NavigationView.MenuItems>

                <ui:NavigationViewItemHeader Text="PREPARE" />
                <ui:NavigationViewItem
                    Content="Documents"
                    Tag="documents"
                    TargetPageType="{x:Type pages:DocumentsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DocumentSplitHint24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem
                    Content="Test set"
                    Tag="test-set"
                    TargetPageType="{x:Type pages:GenerateTestSetPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DocumentAdd24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItemHeader Text="EXPERIMENT" />
                <ui:NavigationViewItem
                    Content="Run"
                    Tag="run"
                    TargetPageType="{x:Type pages:RunEvalPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Play24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem
                    Content="Results"
                    Tag="results"
                    TargetPageType="{x:Type pages:MetricsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DataHistogram24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItemHeader Text="LEGACY (BEING REPLACED)" />
                <ui:NavigationViewItem
                    Content="Runs"
                    Tag="legacy-runs"
                    TargetPageType="{x:Type pages:RunsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="List24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

            </ui:NavigationView.MenuItems>
            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>