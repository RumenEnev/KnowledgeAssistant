<ui:FluentWindow
    x:Class="RagEvaluation.Desktop.Windows.EditChunkWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Edit Chunk"
    Width="700"
    Height="500"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Edit Chunk" Grid.Row="0" />

        <TextBlock
            x:Name="HeaderText"
            Grid.Row="1"
            Margin="0,8,0,8"
            FontWeight="SemiBold"
            Text="Chunk" />

        <TextBox
            x:Name="ChunkTextBox"
            Grid.Row="2"
            AcceptsReturn="True"
            AcceptsTab="True"
            FontFamily="Consolas"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />

        <StackPanel
            Grid.Row="3"
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                Margin="0,0,8,0"
                Padding="12,6"
                Click="CancelButton_Click"
                Content="Cancel" />
            <ui:Button
                Padding="12,6"
                Appearance="Primary"
                Click="SaveButton_Click"
                Content="Save" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
