<Window
    x:Class="RagEvaluation.Desktop.Windows.GenerationDetailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Query Detail"
    Width="800"
    Height="650"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    ScrollViewer.CanContentScroll="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="QueryTextBlock"
            Grid.Row="0"
            Margin="0,0,0,4"
            FontSize="16"
            FontWeight="SemiBold"
            TextWrapping="Wrap" />

        <TextBlock
            x:Name="ScoresTextBlock"
            Grid.Row="1"
            Margin="0,0,0,16"
            Foreground="Gray" />

        <TabControl Grid.Row="2">
            <TabItem Header="Generated Answer">
                <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        x:Name="AnswerTextBlock"
                        TextWrapping="Wrap" />
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Context Chunks">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ChunksItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Card Margin="0,0,0,8" Padding="12">
                                        <StackPanel>
                                            <TextBlock
                                                Margin="0,0,0,6"
                                                FontWeight="SemiBold"
                                                Text="{Binding ChunkId, StringFormat='Chunk #{0}'}" />
                                            <TextBlock Text="{Binding ChunkText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Judge Rationale">
                <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        x:Name="RationaleTextBlock"
                        TextWrapping="Wrap" />
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel
            Grid.Row="3"
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                x:Name="CopyToClipboardButton"
                Margin="0,0,8,0"
                Padding="16,6"
                Click="CopyToClipboardButton_Click"
                Content="Copy to Clipboard" />
            <ui:Button
                Padding="16,6"
                Click="CloseButton_Click"
                Content="Close" />
        </StackPanel>
    </Grid>
</Window>