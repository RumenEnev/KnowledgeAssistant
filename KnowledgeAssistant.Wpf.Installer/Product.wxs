<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"><?define KnowledgeAssistant.Wpf_TargetDir=$(var.KnowledgeAssistant.Wpf.TargetDir)?>
	<Product Id="*" Name="KnowledgeAssistant.Wpf.Installer" Language="1033" Version="1.0.47.279" Manufacturer="Rumen Enev" UpgradeCode="b8db19bb-f705-44ef-896a-49c01d52de83">
		<Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />

		<MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
		<MediaTemplate EmbedCab="yes" />

		<Property Id="INSTALLFOLDER" Value="C:\My\Production\KnowledgeAssistant" />
		
		<Feature Id="ProductFeature" Title="KnowledgeAssistant.Wpf.Installer" Level="1">
			<ComponentGroupRef Id="ProductComponents" />
			<ComponentRef Id="ApplicationShortcut" />
		</Feature>

		<Directory Id="TARGETDIR" Name="SourceDir">
			<Directory Id="ProgramFilesFolder">
				<Directory Id="INSTALLFOLDER" Name="KnowledgeAssistant">
					<Directory Id="Resources" Name="Resources" />
				</Directory>
				<Directory Id="Resources_Common" Name="Common" />
				<Directory Id="Resources_MainWindow" Name="MainWindow">
					<Directory Id="Resources_MainWindow_MainMenu" Name="MainMenu" />
				</Directory>
			</Directory>
			<Directory Id="ProgramMenuFolder">
				<Directory Id="KnowledgeAssistant" Name="Knowledge Assistant" />
			</Directory>
		</Directory>

		<DirectoryRef Id="KnowledgeAssistant">
			<Component Id="ApplicationShortcut" Guid="14F437DD-94E3-4D65-9733-580BD716634B">
				<Shortcut Id="StartMenuShortcut" Name="Knowledge Assistant" Description="Launch Knowledge Assistant" Target="[INSTALLFOLDER]KnowledgeAssistant.exe" WorkingDirectory="INSTALLFOLDER" />
				<RemoveFolder Id="RemoveStartMenuFolder" Directory="KnowledgeAssistant" On="uninstall" />
				<RegistryValue Root="HKCU" Key="Software\KnowledgeAssistant" Name="installed" Type="integer" Value="1" KeyPath="yes" />
			</Component>
		</DirectoryRef>
	</Product>

